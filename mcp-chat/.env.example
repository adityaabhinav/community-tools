# ThoughtSpot cluster URL (no trailing slash)
TS_HOST=https://ps-internal.thoughtspot.cloud

# ThoughtSpot bearer token — generate from: Admin > Security > Token Management
TS_TOKEN=your_bearer_token_here

# Worksheet / data source UUID to query against
# Find it in the worksheet URL: thoughtspot.cloud/...#/worksheet/YOUR-UUID-HERE
TS_WORKSHEET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: ThoughtSpot password for auto token refresh
# If set, the backend will refresh the token automatically when it expires
TS_PASSWORD=your_password_here

# Optional: trusted-auth secret key — alternative to TS_PASSWORD for auto refresh
# (useful when the user is SSO-managed and basic password login is blocked)
TS_SECRET_KEY=

# Optional: Anthropic API key — only needed for the "Claude + MCP" mode
ANTHROPIC_API_KEY=

# Optional: org ID for multi-org ThoughtSpot clusters
# If your cluster uses orgs, set this to the numeric org ID you want to query against
TS_ORG_ID=
