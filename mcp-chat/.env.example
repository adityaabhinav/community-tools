# ThoughtSpot cluster URL (no trailing slash)
TS_HOST=https://ps-internal.thoughtspot.cloud

# ── Authentication (choose one approach) ──────────────────────────────────────

# Option A — Username + Password (recommended, no manual token needed)
# The backend logs in on startup and auto-refreshes on expiry.
TS_USERNAME=your_username
TS_PASSWORD=your_password

# Option B — Static bearer token (paste one from Admin > Security > Token Management)
# Leave blank if using Option A.
TS_TOKEN=

# Option C — Trusted-auth secret key (alternative to password for SSO users)
TS_SECRET_KEY=

# ── Data source ────────────────────────────────────────────────────────────────

# Worksheet / model UUID to query against by default.
# Find it in the worksheet URL: .../worksheet/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TS_WORKSHEET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Optional ───────────────────────────────────────────────────────────────────

# Anthropic API key — only needed for the "Claude + MCP" mode
ANTHROPIC_API_KEY=

# Numeric org ID for multi-org ThoughtSpot clusters
TS_ORG_ID=
