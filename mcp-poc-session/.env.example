# ThoughtSpot cluster URL (no trailing slash)
TS_HOST=https://your-cluster.thoughtspot.cloud

# Credentials for session-cookie auth
TS_USERNAME=your.name@thoughtspot.com
TS_PASSWORD=your_password_here

# Worksheet / data source UUID to query against
TS_WORKSHEET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: org ID for multi-org clusters
TS_ORG_ID=

# Optional: pin a specific bearer token. If left blank, the backend
# auto-fetches one from /auth/token/full using TS_USERNAME + TS_PASSWORD on
# every startup/re-login — so you normally don't need to set this.
TS_TOKEN=

# Optional: Anthropic API key (only needed for claude_mcp mode)
ANTHROPIC_API_KEY=
